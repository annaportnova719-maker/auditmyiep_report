# Copy this file to ".env" (remove ".example") and fill in your real values.
# NEVER share this file or paste your real key/password in a chat, email, or
# commit it to any code-sharing site.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model used to audit IEPs.
# CLAUDE_MODEL=claude-sonnet-4-5

# Needed only for the "email me a copy" feature (backend/app.py's
# /api/email-report). Leave these out and that one feature just returns a
# clear error — everything else in the app still works fine without it.
#
# ZOHO_EMAIL is the mailbox you send FROM, e.g. help@auditmyiep.com.
# ZOHO_APP_PASSWORD is NOT your normal Zoho login password — it's a separate,
# app-specific password you generate for this. To get one:
#   1. Sign in at mail.zoho.com.
#   2. Click your profile icon (top right) -> My Account.
#   3. Go to Security -> App Passwords.
#   4. Click Generate New Password, name it "AuditMyIEP backend", and copy
#      the password it shows you ONE time only.
#   5. Paste that here as ZOHO_APP_PASSWORD.
ZOHO_EMAIL=help@auditmyiep.com
ZOHO_APP_PASSWORD=paste-the-app-specific-password-here
